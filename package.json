{
    "name": "opengraphica",
    "version": "0.0.2-alpha.1",
    "author": "OpenGraphica devs",
    "license": "MIT",
    "description": "A mobile and web friendly image editor - create both raster and vector graphics.",
    "private": false,
    "main": "electron/main.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/opengraphica/opengraphica/"
    },
    "scripts": {
        "dev": "npm run dev:web",
        "dev:android": "npm run build && npx cap sync android",
        "dev:electron": "electron .",
        "dev:web": "webpack serve --config ./webpack.config.dev.js",
        "build": "npm run build:website",
        "build:css": "node ./src/css/build.js",
        "build:library": "webpack --mode=production --config ./webpack.config.library.js",
        "build:webfont": "node ./scripts/webfont.js",
        "build:website": "webpack --mode=production --config ./webpack.config.website.js",
        "build:website:inspect": "node --inspect webpack --config ./webpack.config.website.js --stats verbose",
        "serve": "npm run dev:web",
        "start": "npm run dev:web",
        "translate": "node ./scripts/translate.js"
    },
    "dependencies": {
        "@capacitor/android": "8.5.2",
        "@capacitor/app": "8.1.2",
        "@capacitor/camera": "8.2.5",
        "@capacitor/core": "8.5.2",
        "@capacitor/file-transfer": "2.0.5",
        "@capacitor/filesystem": "8.1.3",
        "@capacitor/share": "8.0.2",
        "@capacitor/splash-screen": "8.0.2",
        "@capgo/capacitor-share-target": "8.0.54",
        "@capgo/capacitor-updater": "8.52.1",
        "@floating-ui/vue": "1.1.6",
        "bezier-js": "6.1.3",
        "bidi-js": "1.0.3",
        "bootstrap-icons": "1.11.3",
        "capacitor-blob-writer": "1.1.20",
        "color-namer": "1.4.0",
        "element-plus": "2.2.28",
        "eruda": "3.0.1",
        "expr-eval": "2.0.2",
        "fflate": "0.8.3",
        "file-saver": "2.0.5",
        "gifken": "2.1.1",
        "libgif": "0.0.3",
        "lodash": "4.17.21",
        "mitt": "2.1.0",
        "pica": "6.1.1",
        "resize-observer-polyfill": "1.5.1",
        "three": "0.185.1",
        "unplugin-element-plus": "0.2.0",
        "uuid": "8.3.2",
        "vue": "3.5.13",
        "vue-i18n": "11.4.10",
        "webdav": "5.10.0"
    },
    "devDependencies": {
        "@capacitor/cli": "8.5.2",
        "@tailwindcss/postcss": "4.0.17",
        "@types/bezier-js": "4.1.0",
        "@types/color-namer": "1.3.0",
        "@types/file-saver": "2.0.2",
        "@types/lodash": "4.14.168",
        "@types/node": "14.14.35",
        "@types/offscreencanvas": "2019.7.3",
        "@types/pica": "5.1.2",
        "@types/three": "0.185.4",
        "@types/uuid": "8.3.4",
        "@vue/compiler-sfc": "3.5.13",
        "clean-webpack-plugin": "3.0.0",
        "copy-webpack-plugin": "8.1.0",
        "css-loader": "6.5.1",
        "electron": "44.5.1",
        "file-loader": "6.2.0",
        "font-loader": "0.1.2",
        "fork-ts-checker-webpack-plugin": "7.3.0",
        "html-webpack-plugin": "5.3.1",
        "node-gyp": "8.4.1",
        "postcss": "^8.5.3",
        "postcss-loader": "8.1.1",
        "postcss-prefix-selector": "1.9.0",
        "postcss-pxtorem": "6.0.0",
        "sass": "1.32.8",
        "sass-loader": "12.4.0",
        "style-loader": "3.3.1",
        "tailwindcss": "4.0.17",
        "ts-loader": "9.4.2",
        "typescript": "5.8.3",
        "vue-loader": "17.0.1",
        "vue-tsc": "0.0.8",
        "webfont": "^11.2.26",
        "webpack": "5.98.0",
        "webpack-bundle-analyzer": "4.4.0",
        "webpack-cli": "6.0.1",
        "webpack-comment-remover-loader": "0.0.3",
        "webpack-dev-server": "4.7.3"
    }
}
